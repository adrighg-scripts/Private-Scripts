local function toggleXRay()
    if not isInMatch() then return end
    if not XRAY_ACTIVE then
        affectedParts = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < IGNORE_THRESHOLD then
                local isPlayerPart = false
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character and obj:IsDescendantOf(player.Character) then
                        isPlayerPart = true
                        break
                    end
                end
                
                if not isPlayerPart then
                    affectedParts[obj] = obj.Transparency
                    obj.Transparency = TARGET_TRANSPARENCY
                end
            end
        end
        XRAY_ACTIVE = true
    else
        for part, transparency in pairs(affectedParts) do
            if part and part.Parent then
                part.Transparency = transparency
            end
        end
        affectedParts = {}
        XRAY_ACTIVE = false
    end
end

----------------------------------------------------------------------
-- 🎯 Ultra-Stable, Non-Jittery Camera Aim Assist (Rock-Solid Locking)
----------------------------------------------------------------------
local function getTargetPartFromCharacter(char)
    if aimHitboxMode == "Head" then
        return char:FindFirstChild("Head")
    elseif aimHitboxMode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif aimHitboxMode == "Left Arm" then
        return char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
    elseif aimHitboxMode == "Right Arm" then
        return char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
    elseif aimHitboxMode == "Left Leg" then
        return char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
    elseif aimHitboxMode == "Right Leg" then
        return char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
    else
        local rand = math.random(1, 100)
        local chosenCategory = "Torso"
        if rand <= 10 then
            chosenCategory = "Head"
        elseif rand <= 50 then
            chosenCategory = "Torso"
        elseif rand <= 65 then
            chosenCategory = "Left Arm"
        elseif rand <= 80 then
            chosenCategory = "Right Arm"
        elseif rand <= 90 then
            chosenCategory = "Left Leg"
        else
            chosenCategory = "Right Leg"
        end
        
        for _, partName in ipairs(TARGET_PARTS_MAP[chosenCategory]) do
            local foundPart = char:FindFirstChild(partName)
            if foundPart then
                return foundPart
            end
        end
        
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
end

local function findNearestPlayer()
    local closestPlayer = nil
    local closestDistance = aimFov
    local closestPart = nil
    
    local camera = workspace.CurrentCamera
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character and isTargetPlayer(otherPlayer) then
            local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")
            local targetPart = getTargetPartFromCharacter(otherPlayer.Character)
            
            if humanoid and humanoid.Health > 0 and targetPart then
                if not aimWallCheck or hasLineOfSight(targetPart) then
                    local screenPoint, visible = camera:WorldToScreenPoint(targetPart.Position)
                    if visible then
                        local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                        if distance <= closestDistance then
                            closestDistance = distance
                            closestPlayer = otherPlayer
                            closestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    
    return closestPlayer, closestPart
end

local function permanentAim()
    if not aiming or not isInMatch() then return end
    
    if lockedTarget and lockedTarget.Parent then
        local humanoid = lockedTarget.Parent:FindFirstChild("Humanoid")
        if humanoid and humanoid.Health > 0 and (not aimWallCheck or hasLineOfSight(lockedTarget)) then
            currentTarget = lockedTarget
        else
            lockedTarget, currentTarget = nil, nil
            return
        end
    elseif not currentTarget then
        local _, targetPart = findNearestPlayer()
        if targetPart then
            currentTarget = targetPart
            lockedTarget = targetPart
        else
            return
        end
    end
    
    if not currentTarget or not currentTarget.Parent then
        currentTarget, lockedTarget = nil, nil
        return
    end
    
    local camera = workspace.CurrentCamera
    local targetPos = currentTarget.Position
    local currentCamCFrame = camera.CFrame
    
    local targetRotation = CFrame.new(currentCamCFrame.Position, targetPos)
    local alpha = math.clamp(1 / math.max(aimSmoothness, 1), 0.05, 1)
    camera.CFrame = currentCamCFrame:Lerp(targetRotation, alpha)
end

----------------------------------------------------------------------
