            if desc:IsA("BasePart") then
                local partHighlight = Instance.new("Highlight")
                partHighlight.Name = "PartHighlight"
                partHighlight.Adornee = desc
                partHighlight.Parent = character
                partHighlight.FillTransparency = 0.5
                partHighlight.OutlineTransparency = 0

                if hasLineOfSight(desc) then
                    partHighlight.FillColor = VISIBLE_HIGHLIGHT_COLOR
                    partHighlight.OutlineColor = VISIBLE_OUTLINE_COLOR
                else
                    partHighlight.FillColor = HIGHLIGHT_COLOR
                    partHighlight.OutlineColor = OUTLINE_COLOR
                end
            end
        end
    else
        local mainHighlight = character:FindFirstChild("Highlight")
        if not mainHighlight then
            removeHighlights(character)
            mainHighlight = Instance.new("Highlight")
            mainHighlight.Name = "Highlight"
            mainHighlight.Adornee = character
            mainHighlight.Parent = character
        end
        mainHighlight.FillColor = HIGHLIGHT_COLOR
        mainHighlight.OutlineColor = OUTLINE_COLOR
        mainHighlight.FillTransparency = 0.5
        mainHighlight.OutlineTransparency = 0
    end
end

local function getPlayerName(player)
