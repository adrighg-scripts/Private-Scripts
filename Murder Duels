local function checkAimKeyTrigger(input, isBegan)
    if not ACTIVE or not isInMatch() or not aimEnabled then return end
    
    local isMatchKey = false
    if aimKey == "MouseButton2" and input.UserInputType == Enum.UserInputType.MouseButton2 then
        isMatchKey = true
    elseif aimKey == "MouseButton1" and input.UserInputType == Enum.UserInputType.MouseButton1 then
        isMatchKey = true
    elseif aimKey == "E" and input.KeyCode == Enum.KeyCode.E then
        isMatchKey = true
    elseif aimKey == "Q" and input.KeyCode == Enum.KeyCode.Q then
        isMatchKey = true
    elseif aimKey == "F" and input.KeyCode == Enum.KeyCode.F then
        isMatchKey = true
    elseif aimKey == "Shift" and (input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift) then
        isMatchKey = true
    end
    
    if isMatchKey then
        if isBegan then
            aiming = true
            if not lockedTarget then
                local _, targetPart = findNearestPlayer()
                if targetPart then
                    lockedTarget = targetPart
                    currentTarget = targetPart
                end
            end
            if not aimConnection then
                aimConnection = RunService.RenderStepped:Connect(permanentAim)
            end
        else
            aiming = false
            lockedTarget, currentTarget = nil, nil
            if aimConnection then
                aimConnection:Disconnect()
                aimConnection = nil
            end
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isInMatch() then return end
    checkAimKeyTrigger(input, true)
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed or not isInMatch() then return end
    checkAimKeyTrigger(input, false)
end)

