            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.DisplayName ~= "" then
                playerName = humanoid.DisplayName
            end
        end
    end
    
    cachedPlayerData[player].name = playerName
    return playerName
