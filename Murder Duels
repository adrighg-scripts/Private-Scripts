RunService.RenderStepped:Connect(function(dt)
    if not ACTIVE then return end
    
    if not isInMatch() then
        customCursor.Visible = false
        speedLabel.Visible = false
        return
    end
    
    if MOUSE_UNLOCK_ENABLED then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        local mouseLocation = UserInputService:GetMouseLocation()
        customCursor.Position = UDim2.new(0, mouseLocation.X, 0, mouseLocation.Y + CUSTOM_CURSOR_OFFSET_Y)
        
        local viewportPoint = Vector2.new(mouseLocation.X, mouseLocation.Y + CUSTOM_CURSOR_OFFSET_Y)
        local ray = workspace.CurrentCamera:ViewportPointToRay(viewportPoint.X, viewportPoint.Y)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, speedGui}
        else
            raycastParams.FilterDescendantsInstances = {speedGui}
        end
        raycastParams.IgnoreWater = true
        
        local result = workspace:Raycast(ray.Origin, ray.Direction * 500, raycastParams)
        if result and result.Instance and result.Instance:IsA("BasePart") then
            local color = result.Instance.Color
            local brightness = (color.R * 0.299 + color.G * 0.587 + color.B * 0.114)
            if brightness > 0.5 then
                customCursor.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                cursorStroke.Color = Color3.fromRGB(255, 255, 255)
            else
                customCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                cursorStroke.Color = Color3.fromRGB(0, 0, 0)
            end
        else
            customCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            cursorStroke.Color = Color3.fromRGB(0, 0, 0)
        end
        
        customCursor.Visible = true
    else
        customCursor.Visible = false
    end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local velocity = root.AssemblyLinearVelocity
    local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    local currentSpeed = horizontalVelocity.Magnitude
    
    if SHOW_SPEED then
        speedLabel.Text = string.format("Speed: %.1f studs/s", currentSpeed)
        speedLabel.Visible = true
    else
        speedLabel.Visible = false
    end

    if BHOP_ENABLED then
        local isSpaceDown = UserInputService:IsKeyDown(Enum.KeyCode.Space)
        if isSpaceDown then
            if not bhopWasJumping then
                bhopStartTime = tick()
                bhopWasJumping = true
            end

            if humanoid:GetState() ~= Enum.HumanoidStateType.Freefall and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            
            local x = humanoid.WalkSpeed
            if x > 2 and horizontalVelocity.Magnitude > 0.1 then
                local maxDuration = math.clamp(BHOP_PERCENT_BOOST / 40, 0.05, 5.0)
                local elapsed = tick() - bhopStartTime
                local alpha = math.clamp(elapsed / maxDuration, 0, 1)
                
                local currentBoostPercent = BHOP_PERCENT_BOOST * alpha
                local z = x + (x * (currentBoostPercent / 100))
                local newHorizontalVel = horizontalVelocity.Unit * z
                root.AssemblyLinearVelocity = Vector3.new(newHorizontalVel.X, velocity.Y, newHorizontalVel.Z)
            end
        else
            bhopWasJumping = false
        end
    end
end)

