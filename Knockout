    if flyMode == "items" or flyMode == "both" then
        updateItemTargets()
    end
end

-- ===== ROUTE STARTEN =====
local function startRoute()
    if loopRunning then return end
    
    updateTargetPlayers()
    updateItemTargets()
    
    local hasPlayers = #targetPlayers > 0
    local hasItems = #itemTargets > 0
    
    local canStart = false
    if flyMode == "players" and hasPlayers then
        canStart = true
    elseif flyMode == "items" and hasItems then
        canStart = true
    elseif flyMode == "both" and (hasPlayers or hasItems) then
        canStart = true
    end
    
    if canStart then
        resetProgress()
        lastPosition = nil
        tweeting = true
        completed = false
        
        statusLabel.Text = flyMode:upper() .. " MODE"
        statusSubLabel.Text = string.format("%d Players • %d Items", #targetPlayers, #itemTargets)
        statusGlow.BackgroundColor3 = colors.success
        statusIcon.TextColor3 = colors.success
        statusIcon.Text = "🐧"
        startBtn.BackgroundColor3 = colors.surfaceLight
    else
        statusLabel.Text = "No Targets"
        statusSubLabel.Text = "No valid targets available"
        statusGlow.BackgroundColor3 = colors.danger
        statusIcon.TextColor3 = colors.danger
    end
end

