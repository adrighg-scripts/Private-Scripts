local function getUniqueItemNames()
    local objects = workspace:FindFirstChild("SpawnedObjects")
    if not objects then return {} end
    
    local uniqueNames = {}
    local nameCount = {}
    
    for _, child in ipairs(objects:GetChildren()) do
        local objName = child.Name
        if not nameCount[objName] then
            table.insert(uniqueNames, objName)
            nameCount[objName] = true
        end
    end
    
    return uniqueNames
end

local function findItemPosition(item)
    if item:IsA("BasePart") then
        return item.Position
    elseif item:IsA("Model") then
        if item.PrimaryPart then
            return item.PrimaryPart.Position
        end
        for _, part in ipairs(item:GetDescendants()) do
            if part:IsA("BasePart") then
                return part.Position
            end
        end
    end
    return nil
end

-- ===== AUTO SWITCH SERVER =====
function ListServers(cursor)
    local Raw = game:HttpGet(_servers .. ((cursor and "&cursor="..cursor) or ""))
    return Http:JSONDecode(Raw)
end

local function startAutoSwitchServer()
    if switchServerConnection then
        switchServerConnection:Disconnect()
    end
    
    switchServerConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not autoSwitchActive then return end
        
        local playerCount = #Players:GetPlayers()
        
        if playerCount < 4 then
            local startTime = tick()
            
            while tick() - startTime < 10 do
                task.wait(1)
                if #Players:GetPlayers() >= 4 or not autoSwitchActive then
                    return
                end
            end
            
            if #Players:GetPlayers() < 4 and autoSwitchActive then
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.Anchored = true
                end
                
                local Servers = ListServers()
                if Servers and Servers.data and #Servers.data > 0 then
                    local Server = Servers.data[math.random(1, #Servers.data)]
                    TPS:TeleportToPlaceInstance(_place, Server.id, player)
                end
            end
        end
    end)
end

local function stopAutoSwitchServer()
    if switchServerConnection then
        switchServerConnection:Disconnect()
        switchServerConnection = nil
    end
end

