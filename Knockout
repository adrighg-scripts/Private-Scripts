    if modeIndex > 3 then modeIndex = 1 end
    
    flyMode = modeTexts[modeIndex]
    modeBtn.Text = flyMode:upper()
    modeBtn.BackgroundColor3 = modeColors[modeIndex]
    loopStatusValue.Text = flyMode:upper()
