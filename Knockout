-- ===== FLUG FUNKTIONEN (OHNE NOCLIP) =====
local function flyToPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end
    
    local myChar = player.Character
    if not myChar then return end
    
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    if not lastPosition then
        lastPosition = myHrp.CFrame
    end
    
    if flyConnection then
        flyConnection:Disconnect()
    end
    
    flyConnection = RunService.Heartbeat:Connect(function()
        if not tweeting or not player.Character or not targetPlayer.Character then
            return
        end
        
        local currentHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local currentTargetHrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if currentHrp and currentTargetHrp then
            local direction = (currentTargetHrp.Position - currentHrp.Position).Unit
            currentHrp.Velocity = direction * flySpeed
            currentHrp.CFrame = CFrame.lookAt(currentHrp.Position, currentTargetHrp.Position)
        end
    end)
    
    statusLabel.Text = "Target: " .. targetPlayer.Name
    statusSubLabel.Text = "Flying to player..."
    statusGlow.BackgroundColor3 = colors.player
    statusIcon.TextColor3 = colors.player
    statusIcon.Text = "🐧"
end

local function flyToItem(itemName)
    local objects = workspace:FindFirstChild("SpawnedObjects")
    if not objects then return end
    
    for _, child in ipairs(objects:GetChildren()) do
        if child.Name == itemName then
            local targetPosition = findItemPosition(child)
            if not targetPosition then return end
            
            local myChar = player.Character
            if not myChar then return end
            
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if not myHrp then return end
            
            if not lastPosition then
                lastPosition = myHrp.CFrame
            end
            
            if flyConnection then
                flyConnection:Disconnect()
            end
            
            flyConnection = RunService.Heartbeat:Connect(function()
                if not tweeting or not player.Character or not child or not child.Parent then
                    return
                end
                
                local currentHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local currentPos = findItemPosition(child)
                
                if currentHrp and currentPos then
                    local direction = (currentPos - currentHrp.Position).Unit
                    currentHrp.Velocity = direction * flySpeed
                    currentHrp.CFrame = CFrame.lookAt(currentHrp.Position, currentPos)
                end
            end)
            
            statusLabel.Text = "Item: " .. child.Name
            statusSubLabel.Text = "Flying to item..."
            statusGlow.BackgroundColor3 = colors.item
            statusIcon.TextColor3 = colors.item
            statusIcon.Text = "💎"
            break
        end
    end
end

local function stopFlying()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    local myChar = player.Character
    if myChar then
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            myHrp.Velocity = Vector3.new(0, 0, 0)
        end
    end
end

local function returnToLastPosition()
    if lastPosition then
        local myChar = player.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            stopFlying()
            myHrp.CFrame = lastPosition
            lastPosition = nil
        end
    end
end

