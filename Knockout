end)

-- ===== HAUPTLOOP =====
task.spawn(function()
    while true do
        if tweeting and not completed then
            loopRunning = true
            
            -- Players
            if (flyMode == "players" or flyMode == "both") and #targetPlayers > 0 and currentIndex <= #targetPlayers then
                local target = targetPlayers[currentIndex]
                if target then
                    flyToPlayer(target)
                    
                    local myChar = player.Character
                    local targetChar = target.Character
                    
                    if myChar and targetChar then
                        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                        local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                        
                        if myHrp and targetHrp then
                            local startTime = tick()
                            while tweeting and target and target.Character do
                                myHrp = myChar:FindFirstChild("HumanoidRootPart")
                                targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
                                
                                if not myHrp or not targetHrp then break end
                                
                                local distance = (myHrp.Position - targetHrp.Position).Magnitude
                                
                                if distance < 3 then
                                    break
                                end
                                
                                if tick() - startTime > 3 then
                                    break
                                end
                                
                                task.wait()
                            end
                        end
                    end
                end
                
                currentIndex = currentIndex + 1
                
            -- Items
            elseif (flyMode == "items" or (flyMode == "both" and currentIndex > #targetPlayers)) and #itemTargets > 0 and currentItemIndex <= #itemTargets then
                local itemName = itemTargets[currentItemIndex]
                if not processedItems[itemName] then
                    processedItems[itemName] = true
                    flyToItem(itemName)
                    
                    local myChar = player.Character
                    
                    if myChar then
                        local startTime = tick()
                        while tweeting do
                            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                            if not myHrp then break end
                            
                            -- Prüfe Distanz
                            local objects = workspace:FindFirstChild("SpawnedObjects")
                            if objects then
                                for _, child in ipairs(objects:GetChildren()) do
                                    if child.Name == itemName then
                                        local pos = findItemPosition(child)
                                        if pos and (myHrp.Position - pos).Magnitude < 3 then
                                            break
                                        end
                                    end
                                end
                            end
                            
                            if tick() - startTime > 3 then
                                break
                            end
                            
                            task.wait()
                        end
                    end
                end
                
                currentItemIndex = currentItemIndex + 1
                
            -- Fertig
            else
                tweeting = false
                completed = true
                stopFlying()
                returnToLastPosition()
                statusLabel.Text = "Completed!"
                statusSubLabel.Text = "Route finished"
                statusGlow.BackgroundColor3 = colors.info
                statusIcon.TextColor3 = colors.info
                statusIcon.Text = "🐧"
                startBtn.BackgroundColor3 = colors.success
                loopRunning = false
            end
        end
        task.wait(0.1)
    end
end)

